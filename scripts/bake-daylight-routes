#!/usr/bin/env node
/* =============================================
   bake-daylight-routes

   Reads stage data from the sibling open-pilgrimages repo and writes
   trimmed, daylight-budget-ready JSON into assets/daylight/. Also
   writes per-route SEO pages into daylight/<route>/index.html from
   scripts/bake-daylight-routes-templates/route.html.

   Run from repo root (or any working directory — paths are resolved
   from __dirname). Re-running produces byte-identical output.

   Usage:
     node scripts/bake-daylight-routes
     ./scripts/bake-daylight-routes

   Output:
     assets/daylight/<route-id>.json   — array of stage records
     assets/daylight/route-meta.json   — summary for all 7 routes
     daylight/<route-id>/index.html    — per-route SEO page (7 files)

   Template syntax: {{placeholder_name}} — keys defined in buildRouteHtmlMap().
   ============================================= */

'use strict';

var fs   = require('fs');
var path = require('path');

/* --- Constants --- */

var REPO_ROOT     = path.resolve(__dirname, '..');
var SIBLING_ROOT  = path.resolve(REPO_ROOT, '..', 'open-pilgrimages');
var ROUTES_DIR    = path.join(SIBLING_ROOT, 'routes');
var OUT_DIR       = path.join(REPO_ROOT, 'assets', 'daylight');
var HTML_OUT_DIR  = path.join(REPO_ROOT, 'daylight');
var TEMPLATE_PATH = path.join(__dirname, 'bake-daylight-routes-templates', 'route.html');

/* Ordered list of routes to bake. Order is canonical — do not rely on
   object key enumeration anywhere below. */
var ROUTE_IDS = [
  'shikoku-88',
  'kumano-kodo',
  'camino-frances',
  'camino-ingles',
  'camino-norte',
  'camino-portugues',
  'camino-primitivo'
];

/* Per-route IANA timezone. Each stage record inherits the route's zone
   (D4: bake-time resolution, no runtime tz lookup needed). */
var ROUTE_TZ = {
  'shikoku-88':      'Asia/Tokyo',
  'kumano-kodo':     'Asia/Tokyo',
  'camino-frances':  'Europe/Madrid',
  'camino-ingles':   'Europe/Madrid',
  'camino-norte':    'Europe/Madrid',
  'camino-portugues':'Europe/Lisbon',
  'camino-primitivo':'Europe/Madrid'
};

/* Required schema version in stages.json and metadata.json. */
var REQUIRED_SCHEMA_VERSION = '1.0.0';

/* --- Fail-loud helper --- */

function die(reason) {
  process.stderr.write('bake-daylight-routes: ' + reason + '\n');
  process.exit(1);
}

/* --- Validation --- */

function readJson(filePath, label) {
  if (!fs.existsSync(filePath)) {
    die('missing or invalid ' + filePath + ' — ' + label + ' not found');
  }
  var raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    die('missing or invalid ' + filePath + ' — could not read: ' + e.message);
  }
  var parsed;
  try {
    parsed = JSON.parse(raw);
  } catch (e) {
    die('missing or invalid ' + filePath + ' — invalid JSON: ' + e.message);
  }
  return parsed;
}

function assertSchemaVersion(data, filePath) {
  if (data.schemaVersion !== REQUIRED_SCHEMA_VERSION) {
    die(
      'missing or invalid ' + filePath +
      ' — schemaVersion must be "' + REQUIRED_SCHEMA_VERSION +
      '", got ' + JSON.stringify(data.schemaVersion)
    );
  }
}

function assertField(value, fieldName, filePath) {
  if (value === undefined || value === null) {
    die('missing or invalid ' + filePath + ' — required field "' + fieldName + '" is absent');
  }
}

/* --- Stage transformation --- */

function bakeStage(stage, ianaTz, stagesPath) {
  var loc = stagesPath + ' stage[' + (stage.index != null ? stage.index : '?') + ']';

  assertField(stage.index,              'index',               loc);
  assertField(stage.name,               'name',                loc);
  assertField(stage.name.en,            'name.en',             loc);
  assertField(stage.start,              'start',               loc);
  assertField(stage.start.coordinates,  'start.coordinates',   loc);
  assertField(stage.distanceKm,         'distanceKm',          loc);
  assertField(stage.elevationGainMeters,'elevationGainMeters', loc);

  var coords = stage.start.coordinates; // [lng, lat, elev_m]
  if (!Array.isArray(coords) || coords.length < 2) {
    die('missing or invalid ' + loc + ' — start.coordinates must be [lng, lat, ...]');
  }

  /* open-pilgrimages uses [lng, lat, elev]; baked schema uses startLat, startLon */
  return {
    index:      stage.index,
    nameEn:     stage.name.en,
    startLat:   coords[1],
    startLon:   coords[0],
    distanceKm: stage.distanceKm,
    elevGainM:  stage.elevationGainMeters,
    ianaTz:     ianaTz
  };
}

/* --- Per-route bake --- */

function bakeRoute(routeId) {
  var ianaTz = ROUTE_TZ[routeId];
  if (!ianaTz) {
    die('missing or invalid route "' + routeId + '" — no entry in ROUTE_TZ table');
  }

  var stagesPath = path.join(ROUTES_DIR, routeId, 'stages.json');
  var stagesData = readJson(stagesPath, 'stages.json for ' + routeId);

  assertSchemaVersion(stagesData, stagesPath);
  assertField(stagesData.stages, 'stages', stagesPath);

  if (!Array.isArray(stagesData.stages) || stagesData.stages.length === 0) {
    die('missing or invalid ' + stagesPath + ' — "stages" must be a non-empty array');
  }

  var baked = stagesData.stages.map(function (stage) {
    return bakeStage(stage, ianaTz, stagesPath);
  });

  var outPath = path.join(OUT_DIR, routeId + '.json');
  try {
    fs.writeFileSync(outPath, JSON.stringify(baked, null, 2) + '\n', 'utf8');
  } catch (e) {
    die('could not write ' + outPath + ': ' + e.message);
  }
  return baked.length;
}

/* --- Route-meta bake --- */

function bakeRouteMeta() {
  var meta = ROUTE_IDS.map(function (routeId) {
    var metaPath = path.join(ROUTES_DIR, routeId, 'metadata.json');
    var data     = readJson(metaPath, 'metadata.json for ' + routeId);

    assertSchemaVersion(data, metaPath);
    assertField(data.id,       'id',       metaPath);
    assertField(data.name,     'name',     metaPath);
    assertField(data.name.en,  'name.en',  metaPath);
    assertField(data.overview, 'overview', metaPath);

    var distanceKm = data.overview.distanceKm;
    assertField(distanceKm, 'overview.distanceKm', metaPath);

    /* country: use overview.countries array (ISO-2); join with '/' for
       multi-country routes so the field stays a plain string */
    var countries = data.overview.countries;
    assertField(countries, 'overview.countries', metaPath);
    if (!Array.isArray(countries) || countries.length === 0) {
      die('missing or invalid ' + metaPath + ' — overview.countries must be a non-empty array');
    }
    var country = countries.join('/');

    return {
      id:         data.id,
      nameEn:     data.name.en,
      distanceKm: distanceKm,
      country:    country,
      ianaTz:     ROUTE_TZ[routeId]
    };
  });

  var outPath = path.join(OUT_DIR, 'route-meta.json');
  try {
    fs.writeFileSync(outPath, JSON.stringify(meta, null, 2) + '\n', 'utf8');
  } catch (e) {
    die('could not write ' + outPath + ': ' + e.message);
  }
}

/* --- HTML baking helpers --- */

function firstSegment(stageName) {
  return stageName.split(' to ')[0].trim();
}

function lastSegment(stageName) {
  var parts = stageName.split(' to ');
  return parts[parts.length - 1].trim();
}

/* Build the stages-prose sentence from stage data and route metadata.
   Format: "N stages from <origin> to <destination>, covering X km of the <route name>."
   Kept under 200 chars. */
function buildStagesProse(stages, nameEn, distanceKm) {
  var origin      = firstSegment(stages[0].nameEn);
  var destination = lastSegment(stages[stages.length - 1].nameEn);
  return (
    stages.length + ' stages from ' + origin + ' to ' + destination +
    ', covering ' + distanceKm + ' km of the ' + nameEn + '.'
  );
}

/* Build the walk-link block if walk-<route>.html exists at repo root. */
function buildWalkLinkBlock(routeId, nameEn) {
  var walkPath = path.join(REPO_ROOT, 'walk-' + routeId + '.html');
  if (!fs.existsSync(walkPath)) return '';
  return (
    '<section class="daylight-walk-link">\n' +
    '      <p>See also: <a href="/walk-' + routeId + '.html">Walking the ' + nameEn + '</a>.</p>\n' +
    '    </section>'
  );
}

/* Substitute {{key}} placeholders in template text.
   Unknown keys are replaced with '' (silent) so partial maps don't explode. */
function renderTemplate(templateText, map) {
  return templateText.replace(/\{\{(\w+)\}\}/g, function (_, key) {
    return (map[key] !== undefined) ? String(map[key]) : '';
  });
}

/* Assert that the rendered HTML contains required SEO signals.
   Fails loud if any signal is missing. */
function assertSeoSignals(html, routeId, nameEn, distanceKm) {
  var checks = [
    { signal: nameEn,              label: 'route_name_en' },
    { signal: String(distanceKm),  label: 'route_distance_km' },
    { signal: 'daylight',          label: '"daylight"' }
  ];
  checks.forEach(function (c) {
    if (html.indexOf(c.signal) === -1) {
      die(
        'SEO assertion failed for ' + routeId +
        ' — rendered HTML does not contain ' + c.label + ' (' + JSON.stringify(c.signal) + ')'
      );
    }
  });
}

/* Bake one per-route HTML page. Returns the output path. */
function bakeRouteHtml(routeId, nameEn, distanceKm, stages, templateText) {
  var stagesCount = stages.length;
  var stagesProse = buildStagesProse(stages, nameEn, distanceKm);
  var walkLinkBlock = buildWalkLinkBlock(routeId, nameEn);

  var map = {
    route_id:          routeId,
    route_name_en:     nameEn,
    route_distance_km: distanceKm,
    stages_count:      stagesCount,
    stages_prose:      stagesProse,
    walk_link_block:   walkLinkBlock
  };

  var html = renderTemplate(templateText, map);
  assertSeoSignals(html, routeId, nameEn, distanceKm);

  var routeDir = path.join(HTML_OUT_DIR, routeId);
  if (!fs.existsSync(routeDir)) {
    fs.mkdirSync(routeDir, { recursive: true });
  }

  var outPath = path.join(routeDir, 'index.html');
  try {
    fs.writeFileSync(outPath, html, 'utf8');
  } catch (e) {
    die('could not write ' + outPath + ': ' + e.message);
  }
  return outPath;
}

/* Bake all 7 per-route HTML pages.
   Reads already-baked JSON stage files from OUT_DIR (so JSON pass must run first). */
function bakeAllRouteHtml(routeMeta) {
  if (!fs.existsSync(TEMPLATE_PATH)) {
    die('missing template: ' + TEMPLATE_PATH);
  }
  var templateText;
  try {
    templateText = fs.readFileSync(TEMPLATE_PATH, 'utf8');
  } catch (e) {
    die('could not read template ' + TEMPLATE_PATH + ': ' + e.message);
  }

  routeMeta.forEach(function (meta) {
    var stagesPath = path.join(OUT_DIR, meta.id + '.json');
    var stages = readJson(stagesPath, 'baked stages for ' + meta.id);

    if (!Array.isArray(stages) || stages.length === 0) {
      die('missing or invalid ' + stagesPath + ' — expected non-empty array');
    }

    bakeRouteHtml(meta.id, meta.nameEn, meta.distanceKm, stages, templateText);
    process.stdout.write('  ' + meta.id + '/index.html written\n');
  });
}

/* --- Entry point --- */

function main() {
  /* Validate sibling repo exists */
  if (!fs.existsSync(SIBLING_ROOT)) {
    die('missing or invalid ' + SIBLING_ROOT + ' — sibling repo not found');
  }
  if (!fs.existsSync(ROUTES_DIR)) {
    die('missing or invalid ' + ROUTES_DIR + ' — routes directory not found in sibling repo');
  }

  /* Ensure output directory exists */
  if (!fs.existsSync(OUT_DIR)) {
    fs.mkdirSync(OUT_DIR, { recursive: true });
  }

  /* Bake each route — JSON pass */
  ROUTE_IDS.forEach(function (routeId) {
    var stageCount = bakeRoute(routeId);
    process.stdout.write('  ' + routeId + ' — ' + stageCount + ' stages\n');
  });

  /* Bake route-meta */
  bakeRouteMeta();
  process.stdout.write('  route-meta.json written\n');

  /* Bake per-route SEO HTML pages */
  var routeMetaPath = path.join(OUT_DIR, 'route-meta.json');
  var routeMeta = readJson(routeMetaPath, 'route-meta.json');
  process.stdout.write('baking HTML pages...\n');
  bakeAllRouteHtml(routeMeta);
  process.stdout.write('  HTML pass complete\n');
}

main();
