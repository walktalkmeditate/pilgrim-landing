#!/usr/bin/env node
/* =============================================
   bake-daylight-routes

   Reads stage data from the sibling open-pilgrimages repo and writes
   trimmed, daylight-budget-ready JSON into assets/daylight/. Also
   writes per-route SEO pages into daylight/<route>/index.html from
   scripts/bake-daylight-routes-templates/route.html.

   Run from repo root (or any working directory — paths are resolved
   from __dirname). Re-running produces byte-identical output.

   Usage:
     node scripts/bake-daylight-routes
     ./scripts/bake-daylight-routes

   Output:
     assets/daylight/<route-id>.json   — array of stage records (with waypoints)
     assets/daylight/route-meta.json   — summary for all 7 routes
     daylight/<route-id>/index.html    — per-route SEO page (7 files, with spider dial)

   Template syntax: {{placeholder_name}} — keys defined in buildRouteHtmlMap().

   Spider-dial idempotency note: the 4-arm polygon axes are normalized to the
   cross-route maximum values. The normalization is idempotent only when ROUTE_IDS
   is unchanged. Adding or removing a route re-scales all routes' dials — every
   per-route HTML will diff on a route-set change. This is intentional (D7: relative
   shape across routes is the point).
   ============================================= */

'use strict';

var fs   = require('fs');
var path = require('path');

/* --- Constants --- */

var REPO_ROOT     = path.resolve(__dirname, '..');
var SIBLING_ROOT  = path.resolve(REPO_ROOT, '..', 'open-pilgrimages');
var ROUTES_DIR    = path.join(SIBLING_ROOT, 'routes');
var OUT_DIR       = path.join(REPO_ROOT, 'assets', 'daylight');
var HTML_OUT_DIR  = path.join(REPO_ROOT, 'daylight');
var TEMPLATE_PATH = path.join(__dirname, 'bake-daylight-routes-templates', 'route.html');

/* Ordered list of routes to bake. Order is canonical — do not rely on
   object key enumeration anywhere below. */
var ROUTE_IDS = [
  'shikoku-88',
  'kumano-kodo',
  'camino-frances',
  'camino-ingles',
  'camino-norte',
  'camino-portugues',
  'camino-primitivo'
];

/* IANA timezone per route, with per-stage overrides for routes that cross
   IANA zone boundaries (D4: bake-time resolution, no runtime tz lookup). */
var ROUTE_TZ = {
  'shikoku-88':      'Asia/Tokyo',
  'kumano-kodo':     'Asia/Tokyo',
  'camino-frances':  'Europe/Madrid',
  'camino-ingles':   'Europe/Madrid',
  'camino-norte':    'Europe/Madrid',
  'camino-portugues':'Europe/Lisbon',
  'camino-primitivo':'Europe/Madrid'
};

/* Per-stage tz overrides for routes whose stages cross IANA zone boundaries.
   Function returns the zone for `stageIndex`, or null to fall back to ROUTE_TZ.
   Camino Portugués: stages 0–4 start in Portugal (Europe/Lisbon, UTC+0/+1);
   stages 5–10 start in Galicia after the Tui border crossing (Europe/Madrid,
   UTC+1/+2). The crossing stage is 4 ("Rubiães to Tui") — start coordinate
   is in Portugal, so it stays on Lisbon time. */
var STAGE_TZ_OVERRIDES = {
  'camino-portugues': function (stageIndex) {
    return stageIndex <= 4 ? 'Europe/Lisbon' : 'Europe/Madrid';
  }
};

function getStageTz(routeId, stageIndex) {
  var override = STAGE_TZ_OVERRIDES[routeId];
  if (override) {
    var z = override(stageIndex);
    if (z) return z;
  }
  return ROUTE_TZ[routeId];
}

/* Required schema version in stages.json and metadata.json. */
var REQUIRED_SCHEMA_VERSION = '1.0.0';

/* Minimum km gap between consecutive kept waypoints within a stage.
   Ensures at most one sacred-site tick per 3-km window on the bar. */
var WAYPOINT_MIN_SPACING_KM = 3;

/* --- Fail-loud helper --- */

function die(reason) {
  process.stderr.write('bake-daylight-routes: ' + reason + '\n');
  process.exit(1);
}

/* --- Waypoint loading + decimation --- */

/* Reads waypoints.geojson for a route, filters to sacred_site features,
   applies 3-km density decimation within each stage, and returns a map of
   stageIndex → [{name, kmFromStart}].

   Fail-loud contract (matches D2 pattern):
   - Exits non-zero if the file is absent.
   - Warns loudly to stderr (but continues with an empty map) if the file
     contains zero sacred_site features. The data for several Camino routes
     currently has no sacred_sites — dying here would break the bake entirely
     for routes that are otherwise valid. Spider-dial density axis will be 0. */
function loadAndDecimateWaypoints(routeId) {
  var wpPath = path.join(ROUTES_DIR, routeId, 'waypoints.geojson');
  if (!fs.existsSync(wpPath)) {
    die('missing or invalid ' + wpPath + ' — waypoints.geojson not found for ' + routeId);
  }
  var raw;
  try {
    raw = fs.readFileSync(wpPath, 'utf8');
  } catch (e) {
    die('missing or invalid ' + wpPath + ' — could not read: ' + e.message);
  }
  var geojson;
  try {
    geojson = JSON.parse(raw);
  } catch (e) {
    die('missing or invalid ' + wpPath + ' — invalid JSON: ' + e.message);
  }

  if (!geojson.features || !Array.isArray(geojson.features)) {
    die('missing or invalid ' + wpPath + ' — "features" must be an array');
  }

  var sacredSites = geojson.features.filter(function (f) {
    return f.properties && f.properties.type === 'sacred_site';
  });

  if (sacredSites.length === 0) {
    process.stderr.write(
      'bake-daylight-routes: warning — ' + wpPath +
      ' contains zero sacred_site features; waypoints will be empty for ' + routeId + '\n'
    );
    return {};
  }

  /* Group by stageIndex */
  var byStage = {};
  sacredSites.forEach(function (f) {
    var idx = f.properties.stageIndex;
    if (idx === undefined || idx === null) return;
    if (!byStage[idx]) byStage[idx] = [];
    byStage[idx].push({
      name:        String(f.properties.name || ''),
      kmFromStart: Number(f.properties.kmFromStart) || 0
    });
  });

  /* Sort each stage's waypoints by kmFromStart, then apply decimation */
  var decimated = {};
  Object.keys(byStage).forEach(function (idx) {
    var sorted = byStage[idx].slice().sort(function (a, b) {
      return a.kmFromStart - b.kmFromStart;
    });
    var kept = [];
    var lastKeptKm = -Infinity;
    sorted.forEach(function (wp) {
      if (wp.kmFromStart - lastKeptKm >= WAYPOINT_MIN_SPACING_KM) {
        kept.push(wp);
        lastKeptKm = wp.kmFromStart;
      }
    });
    decimated[Number(idx)] = kept;
  });

  return decimated;
}

/* --- Validation --- */

function readJson(filePath, label) {
  if (!fs.existsSync(filePath)) {
    die('missing or invalid ' + filePath + ' — ' + label + ' not found');
  }
  var raw;
  try {
    raw = fs.readFileSync(filePath, 'utf8');
  } catch (e) {
    die('missing or invalid ' + filePath + ' — could not read: ' + e.message);
  }
  var parsed;
  try {
    parsed = JSON.parse(raw);
  } catch (e) {
    die('missing or invalid ' + filePath + ' — invalid JSON: ' + e.message);
  }
  return parsed;
}

function assertSchemaVersion(data, filePath) {
  if (data.schemaVersion !== REQUIRED_SCHEMA_VERSION) {
    die(
      'missing or invalid ' + filePath +
      ' — schemaVersion must be "' + REQUIRED_SCHEMA_VERSION +
      '", got ' + JSON.stringify(data.schemaVersion)
    );
  }
}

function assertField(value, fieldName, filePath) {
  if (value === undefined || value === null) {
    die('missing or invalid ' + filePath + ' — required field "' + fieldName + '" is absent');
  }
}

/* --- Stage transformation --- */

/* waypointsByStage: map from stageIndex (number) → [{name, kmFromStart}],
   produced by loadAndDecimateWaypoints. Pass {} if not available. */
function bakeStage(stage, ianaTz, stagesPath, waypointsByStage) {
  var loc = stagesPath + ' stage[' + (stage.index != null ? stage.index : '?') + ']';

  assertField(stage.index,              'index',               loc);
  assertField(stage.name,               'name',                loc);
  assertField(stage.name.en,            'name.en',             loc);
  assertField(stage.start,              'start',               loc);
  assertField(stage.start.coordinates,  'start.coordinates',   loc);
  assertField(stage.distanceKm,         'distanceKm',          loc);
  assertField(stage.elevationGainMeters,'elevationGainMeters', loc);

  var coords = stage.start.coordinates; // [lng, lat, elev_m]
  if (!Array.isArray(coords) || coords.length < 2) {
    die('missing or invalid ' + loc + ' — start.coordinates must be [lng, lat, ...]');
  }

  var waypoints = (waypointsByStage && waypointsByStage[stage.index]) || [];

  /* open-pilgrimages uses [lng, lat, elev]; baked schema uses startLat, startLon */
  return {
    index:      stage.index,
    nameEn:     stage.name.en,
    startLat:   coords[1],
    startLon:   coords[0],
    distanceKm: stage.distanceKm,
    elevGainM:  stage.elevationGainMeters,
    ianaTz:     ianaTz,
    waypoints:  waypoints
  };
}

/* --- Spider-dial helpers --- */

/* Compute the total decimated sacred-site count across all stages for a route.
   waypointsByStage is the map returned by loadAndDecimateWaypoints. */
function totalWaypointCount(waypointsByStage) {
  return Object.keys(waypointsByStage).reduce(function (sum, idx) {
    return sum + waypointsByStage[idx].length;
  }, 0);
}

/* Build a 4-arm spider-dial SVG string for a single route.
   axes: { distanceKm, totalElevGainM, stageCount, waypointDensity }
   axisMaxes: same shape, each field = max across all routes */
function buildSpiderDialSVG(routeId, axes, axisMaxes) {
  var cx = 60, cy = 60, r = 50;

  /* Normalize each axis value to [0, 1]. Guard against zero-max. */
  function norm(val, max) {
    return max > 0 ? Math.min(1, val / max) : 0;
  }

  var nd = norm(axes.distanceKm,      axisMaxes.distanceKm);
  var ne = norm(axes.totalElevGainM,  axisMaxes.totalElevGainM);
  var ns = norm(axes.stageCount,      axisMaxes.stageCount);
  var nw = norm(axes.waypointDensity, axisMaxes.waypointDensity);

  /* 4 arms at 0°/90°/180°/270° (N/E/S/W) → diamond shape.
     N = distance (top), E = elevation (right), S = stage count (bottom), W = density (left).
     SVG y-axis is inverted: N is cy - r*v, S is cy + r*v. */
  var pN  = cx + ',' + (cy - r * nd);
  var pE  = (cx + r * ne) + ',' + cy;
  var pS  = cx + ',' + (cy + r * ns);
  var pW  = (cx - r * nw) + ',' + cy;

  /* Background reference diamond (full extent, very faint) */
  var bgPoints = cx + ',' + (cy - r) + ' ' + (cx + r) + ',' + cy + ' ' + cx + ',' + (cy + r) + ' ' + (cx - r) + ',' + cy;

  /* Foreground polygon (actual route shape) */
  var fgPoints = pN + ' ' + pE + ' ' + pS + ' ' + pW;

  var titleText =
    'Distance ' + axes.distanceKm + ' km · ' +
    'Elevation gain ' + axes.totalElevGainM + ' m · ' +
    'Stages ' + axes.stageCount + ' · ' +
    'Sacred-site density ' + axes.waypointDensity.toFixed(3) + ' sites/km';

  return (
    '<svg class="dl-spider-dial" viewBox="0 0 120 120"' +
    ' width="100" height="100"' +
    ' role="img" aria-label="Route profile dial"' +
    ' xmlns="http://www.w3.org/2000/svg">' +
    '<title>' + titleText + '</title>' +
    '<polygon class="dl-spider-dial-bg" points="' + bgPoints + '"/>' +
    '<polygon class="dl-spider-dial-fg" points="' + fgPoints + '"/>' +
    '</svg>'
  );
}

/* --- Per-route bake --- */

/* Returns { stageCount, bakedStages } where bakedStages carries waypoints.
   Also returns spiderAxes: { distanceKm, totalElevGainM, stageCount, waypointDensity }
   needed for cross-route normalization. */
function bakeRoute(routeId) {
  var ianaTz = ROUTE_TZ[routeId];
  if (!ianaTz) {
    die('missing or invalid route "' + routeId + '" — no entry in ROUTE_TZ table');
  }

  var stagesPath = path.join(ROUTES_DIR, routeId, 'stages.json');
  var stagesData = readJson(stagesPath, 'stages.json for ' + routeId);

  assertSchemaVersion(stagesData, stagesPath);
  assertField(stagesData.stages, 'stages', stagesPath);

  if (!Array.isArray(stagesData.stages) || stagesData.stages.length === 0) {
    die('missing or invalid ' + stagesPath + ' — "stages" must be a non-empty array');
  }

  /* Load waypoints for this route */
  var waypointsByStage = loadAndDecimateWaypoints(routeId);

  var baked = stagesData.stages.map(function (stage) {
    var stageTz = getStageTz(routeId, stage.index);
    if (!stageTz) {
      die('missing or invalid ' + stagesPath + ' — could not resolve ianaTz for stage ' + stage.index);
    }
    return bakeStage(stage, stageTz, stagesPath, waypointsByStage);
  });

  var outPath = path.join(OUT_DIR, routeId + '.json');
  try {
    fs.writeFileSync(outPath, JSON.stringify(baked, null, 2) + '\n', 'utf8');
  } catch (e) {
    die('could not write ' + outPath + ': ' + e.message);
  }

  /* Read metadata for spider-dial axis values */
  var metaPath = path.join(ROUTES_DIR, routeId, 'metadata.json');
  var metaData = readJson(metaPath, 'metadata.json for ' + routeId);
  var distanceKm = metaData.overview && metaData.overview.distanceKm;
  assertField(distanceKm, 'overview.distanceKm', metaPath);

  var totalElevGainM = baked.reduce(function (sum, s) { return sum + s.elevGainM; }, 0);
  var waypointTotal  = totalWaypointCount(waypointsByStage);
  var waypointDensity = distanceKm > 0 ? waypointTotal / distanceKm : 0;

  return {
    stageCount:  baked.length,
    spiderAxes: {
      distanceKm:      distanceKm,
      totalElevGainM:  totalElevGainM,
      stageCount:      baked.length,
      waypointDensity: waypointDensity
    }
  };
}

/* --- Route-meta bake --- */

function bakeRouteMeta() {
  var meta = ROUTE_IDS.map(function (routeId) {
    var metaPath = path.join(ROUTES_DIR, routeId, 'metadata.json');
    var data     = readJson(metaPath, 'metadata.json for ' + routeId);

    assertSchemaVersion(data, metaPath);
    assertField(data.id,       'id',       metaPath);
    assertField(data.name,     'name',     metaPath);
    assertField(data.name.en,  'name.en',  metaPath);
    assertField(data.overview, 'overview', metaPath);

    var distanceKm = data.overview.distanceKm;
    assertField(distanceKm, 'overview.distanceKm', metaPath);

    /* country: use overview.countries array (ISO-2); join with '/' for
       multi-country routes so the field stays a plain string */
    var countries = data.overview.countries;
    assertField(countries, 'overview.countries', metaPath);
    if (!Array.isArray(countries) || countries.length === 0) {
      die('missing or invalid ' + metaPath + ' — overview.countries must be a non-empty array');
    }
    var country = countries.join('/');

    return {
      id:         data.id,
      nameEn:     data.name.en,
      distanceKm: distanceKm,
      country:    country,
      ianaTz:     ROUTE_TZ[routeId]
    };
  });

  var outPath = path.join(OUT_DIR, 'route-meta.json');
  try {
    fs.writeFileSync(outPath, JSON.stringify(meta, null, 2) + '\n', 'utf8');
  } catch (e) {
    die('could not write ' + outPath + ': ' + e.message);
  }
}

/* --- HTML baking helpers --- */

function firstSegment(stageName) {
  return stageName.split(' to ')[0].trim();
}

function lastSegment(stageName) {
  var parts = stageName.split(' to ');
  return parts[parts.length - 1].trim();
}

/* Build the stages-prose sentence from stage data and route metadata.
   Format: "N stages from <origin> to <destination>, covering X km of the <route name>."
   Kept under 200 chars. */
function buildStagesProse(stages, nameEn, distanceKm) {
  var origin      = firstSegment(stages[0].nameEn);
  var destination = lastSegment(stages[stages.length - 1].nameEn);
  return (
    stages.length + ' stages from ' + origin + ' to ' + destination +
    ', covering ' + distanceKm + ' km of the ' + nameEn + '.'
  );
}

/* Build the walk-link block if walk-<route>.html exists at repo root. */
function buildWalkLinkBlock(routeId, nameEn) {
  var walkPath = path.join(REPO_ROOT, 'walk-' + routeId + '.html');
  if (!fs.existsSync(walkPath)) return '';
  return (
    '<section class="daylight-walk-link">\n' +
    '      <p>See also: <a href="/walk-' + routeId + '.html">Walking the ' + nameEn + '</a>.</p>\n' +
    '    </section>'
  );
}

/* Substitute {{key}} placeholders in template text.
   Unknown keys are replaced with '' (silent) so partial maps don't explode. */
function renderTemplate(templateText, map) {
  return templateText.replace(/\{\{(\w+)\}\}/g, function (_, key) {
    return (map[key] !== undefined) ? String(map[key]) : '';
  });
}

/* Assert that the rendered HTML contains required SEO signals.
   Fails loud if any signal is missing. */
function assertSeoSignals(html, routeId, nameEn, distanceKm) {
  var checks = [
    { signal: nameEn,              label: 'route_name_en' },
    { signal: String(distanceKm),  label: 'route_distance_km' },
    { signal: 'daylight',          label: '"daylight"' }
  ];
  checks.forEach(function (c) {
    if (html.indexOf(c.signal) === -1) {
      die(
        'SEO assertion failed for ' + routeId +
        ' — rendered HTML does not contain ' + c.label + ' (' + JSON.stringify(c.signal) + ')'
      );
    }
  });
}

/* Bake one per-route HTML page. Returns the output path. */
function bakeRouteHtml(routeId, nameEn, distanceKm, stages, templateText, spiderDialSvg) {
  var stagesCount = stages.length;
  var stagesProse = buildStagesProse(stages, nameEn, distanceKm);
  var walkLinkBlock = buildWalkLinkBlock(routeId, nameEn);

  var map = {
    route_id:          routeId,
    route_name_en:     nameEn,
    route_distance_km: distanceKm,
    stages_count:      stagesCount,
    stages_prose:      stagesProse,
    walk_link_block:   walkLinkBlock,
    spider_dial_svg:   spiderDialSvg || ''
  };

  var html = renderTemplate(templateText, map);
  assertSeoSignals(html, routeId, nameEn, distanceKm);

  var routeDir = path.join(HTML_OUT_DIR, routeId);
  if (!fs.existsSync(routeDir)) {
    fs.mkdirSync(routeDir, { recursive: true });
  }

  var outPath = path.join(routeDir, 'index.html');
  try {
    fs.writeFileSync(outPath, html, 'utf8');
  } catch (e) {
    die('could not write ' + outPath + ': ' + e.message);
  }
  return outPath;
}

/* Bake all 7 per-route HTML pages.
   Reads already-baked JSON stage files from OUT_DIR (so JSON pass must run first).
   routeSpiderAxes: map from routeId → spiderAxes (collected during JSON pass). */
function bakeAllRouteHtml(routeMeta, routeSpiderAxes) {
  if (!fs.existsSync(TEMPLATE_PATH)) {
    die('missing template: ' + TEMPLATE_PATH);
  }
  var templateText;
  try {
    templateText = fs.readFileSync(TEMPLATE_PATH, 'utf8');
  } catch (e) {
    die('could not read template ' + TEMPLATE_PATH + ': ' + e.message);
  }

  /* Compute cross-route axis maxes for spider-dial normalization */
  var axisMaxes = {
    distanceKm:      0,
    totalElevGainM:  0,
    stageCount:      0,
    waypointDensity: 0
  };
  Object.keys(routeSpiderAxes).forEach(function (id) {
    var axes = routeSpiderAxes[id];
    if (axes.distanceKm      > axisMaxes.distanceKm)      axisMaxes.distanceKm      = axes.distanceKm;
    if (axes.totalElevGainM  > axisMaxes.totalElevGainM)  axisMaxes.totalElevGainM  = axes.totalElevGainM;
    if (axes.stageCount      > axisMaxes.stageCount)      axisMaxes.stageCount      = axes.stageCount;
    if (axes.waypointDensity > axisMaxes.waypointDensity) axisMaxes.waypointDensity = axes.waypointDensity;
  });

  routeMeta.forEach(function (meta) {
    var stagesPath = path.join(OUT_DIR, meta.id + '.json');
    var stages = readJson(stagesPath, 'baked stages for ' + meta.id);

    if (!Array.isArray(stages) || stages.length === 0) {
      die('missing or invalid ' + stagesPath + ' — expected non-empty array');
    }

    var axes = routeSpiderAxes[meta.id];
    var dialSvg = buildSpiderDialSVG(meta.id, axes, axisMaxes);

    bakeRouteHtml(meta.id, meta.nameEn, meta.distanceKm, stages, templateText, dialSvg);
    process.stdout.write('  ' + meta.id + '/index.html written\n');
  });
}

/* --- Entry point --- */

function main() {
  /* Validate sibling repo exists */
  if (!fs.existsSync(SIBLING_ROOT)) {
    die('missing or invalid ' + SIBLING_ROOT + ' — sibling repo not found');
  }
  if (!fs.existsSync(ROUTES_DIR)) {
    die('missing or invalid ' + ROUTES_DIR + ' — routes directory not found in sibling repo');
  }

  /* Ensure output directory exists */
  if (!fs.existsSync(OUT_DIR)) {
    fs.mkdirSync(OUT_DIR, { recursive: true });
  }

  /* Bake each route — JSON pass. Collect spider-dial axes per route. */
  var routeSpiderAxes = {};
  ROUTE_IDS.forEach(function (routeId) {
    var result = bakeRoute(routeId);
    routeSpiderAxes[routeId] = result.spiderAxes;
    process.stdout.write('  ' + routeId + ' — ' + result.stageCount + ' stages\n');
  });

  /* Bake route-meta */
  bakeRouteMeta();
  process.stdout.write('  route-meta.json written\n');

  /* Bake per-route SEO HTML pages */
  var routeMetaPath = path.join(OUT_DIR, 'route-meta.json');
  var routeMeta = readJson(routeMetaPath, 'route-meta.json');
  process.stdout.write('baking HTML pages...\n');
  bakeAllRouteHtml(routeMeta, routeSpiderAxes);
  process.stdout.write('  HTML pass complete\n');
}

main();
