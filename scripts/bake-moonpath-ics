#!/usr/bin/env node
/* =============================================
   bake-moonpath-ics

   Reads assets/moonpath/tide-ports.json, validates schema for every
   port record, then bakes two full-moons ICS files (current year +
   next year) and one tide-port king-tide ICS per baked port.

   Run from repo root:
     node scripts/bake-moonpath-ics
     ./scripts/bake-moonpath-ics

   Exit codes:
     0 — all port records pass validation, all ICS files written
     1 — one or more records are invalid (single-line error to stderr)

   Required JSON shape (assets/moonpath/tide-ports.json):
     {
       "_epoch": "1900-01-01T00:00:00Z",
       "_speedSource": "...",
       "_constituents": [...],
       "_deferred": [...],
       "ports": [
         {
           "id":      string,
           "name":    string,
           "country": string,
           "lat":     number  (−90 … 90),
           "lon":     number  (−180 … 180),
           "source":  string,
           "license": string,
           "constituents": {
             "M2":  { "amp": number, "phase": number, "speed": number },
             ...  (10 entries, one per required constituent)
           }
         },
         ...
       ]
     }
   ============================================= */

'use strict';

var fs   = require('fs');
var path = require('path');

/* --- Constants --- */

var REPO_ROOT   = path.resolve(__dirname, '..');
var PORTS_FILE  = path.join(REPO_ROOT, 'assets', 'moonpath', 'tide-ports.json');
var OUT_DIR     = path.join(REPO_ROOT, 'moonpath');

var REQUIRED_CONSTITUENTS = ['M2', 'S2', 'N2', 'K1', 'O1', 'P1', 'Q1', 'K2', 'M4', 'MS4'];
var REQUIRED_PORT_FIELDS  = ['id', 'name', 'country', 'lat', 'lon', 'source', 'license'];

// ICS identity mirrors sunpath/turnings-2026.ics exactly.
var PRODID         = '-//Pilgrim//Moon Path//EN';
var UID_DOMAIN     = 'pilgrimapp.org';

// King-tide detection window: 30 days forward from bake date.
var KING_TIDE_WINDOW_MS = 30 * 24 * 3600000;
// How close a syzygy must be to a perigee to count as a king tide (±3 days).
var SYZYGY_PERIGEE_TOLERANCE_MS = 3 * 24 * 3600000;
// Synodic month in ms — used to search for the next syzygy after each perigee.
var SYNODIC_MS = 29.53059 * 86400000;

/* --- Load math module (requires sunpath-math.js) --- */

var SunPathMath = require(path.join(REPO_ROOT, 'js', 'sunpath-math.js'));

/* --- Fail-loud helper --- */

function die(reason) {
  process.stderr.write('bake-moonpath-ics: ' + reason + '\n');
  process.exit(1);
}

/* ============================================================
   Validation
   ============================================================ */

function validateConstituents(constituents, portId) {
  if (!constituents || typeof constituents !== 'object') {
    die('port "' + portId + '" — "constituents" must be an object');
  }
  REQUIRED_CONSTITUENTS.forEach(function (name) {
    var c = constituents[name];
    if (!c) {
      die('port "' + portId + '" — missing constituent "' + name + '"');
    }
    if (typeof c.amp !== 'number' || isNaN(c.amp)) {
      die('port "' + portId + '" — constituent "' + name + '".amp must be a number, got ' + JSON.stringify(c.amp));
    }
    if (typeof c.phase !== 'number' || isNaN(c.phase)) {
      die('port "' + portId + '" — constituent "' + name + '".phase must be a number, got ' + JSON.stringify(c.phase));
    }
    if (typeof c.speed !== 'number' || isNaN(c.speed)) {
      die('port "' + portId + '" — constituent "' + name + '".speed must be a number, got ' + JSON.stringify(c.speed));
    }
  });
}

function validatePort(port, index) {
  var label = 'port[' + index + ']' + (port.id ? ' ("' + port.id + '")' : '');

  REQUIRED_PORT_FIELDS.forEach(function (field) {
    if (port[field] === undefined || port[field] === null || port[field] === '') {
      die(label + ' — required field "' + field + '" is missing or empty');
    }
  });

  if (typeof port.lat !== 'number' || isNaN(port.lat) || port.lat < -90 || port.lat > 90) {
    die(label + ' — "lat" must be a number in [−90, 90], got ' + JSON.stringify(port.lat));
  }
  if (typeof port.lon !== 'number' || isNaN(port.lon) || port.lon < -180 || port.lon > 180) {
    die(label + ' — "lon" must be a number in [−180, 180], got ' + JSON.stringify(port.lon));
  }

  validateConstituents(port.constituents, port.id || String(index));
}

/* ============================================================
   ICS formatting helpers
   ============================================================ */

// Format a UTC Date as ICS basic format: YYYYMMDDTHHmmssZ
function fmtICS(dateOrMs) {
  var d = (typeof dateOrMs === 'number') ? new Date(dateOrMs) : dateOrMs;
  function pad(n) { return n < 10 ? '0' + n : String(n); }
  return d.getUTCFullYear() + ''
    + pad(d.getUTCMonth() + 1)
    + pad(d.getUTCDate())
    + 'T'
    + pad(d.getUTCHours())
    + pad(d.getUTCMinutes())
    + pad(d.getUTCSeconds())
    + 'Z';
}

// Fold long ICS lines at 75 octets per RFC 5545 §3.1.
// We keep lines short by construction, but fold summary/description just in case.
function foldLine(line) {
  if (line.length <= 75) return line;
  var out = '';
  while (line.length > 75) {
    out += line.slice(0, 75) + '\r\n ';
    line = line.slice(75);
  }
  out += line;
  return out;
}

function buildVEvent(fields) {
  var lines = ['BEGIN:VEVENT'];
  fields.forEach(function (f) { lines.push(foldLine(f)); });
  lines.push('END:VEVENT');
  return lines.join('\r\n');
}

function buildVCalendar(calname, caldesc, vevents) {
  var header = [
    'BEGIN:VCALENDAR',
    'VERSION:2.0',
    'PRODID:' + PRODID,
    'CALSCALE:GREGORIAN',
    'METHOD:PUBLISH',
    'X-WR-CALNAME:' + calname,
    'X-WR-CALDESC:' + caldesc
  ].join('\r\n');

  return header + '\r\n\r\n' + vevents.join('\r\n\r\n') + '\r\n\r\nEND:VCALENDAR\r\n';
}

/* ============================================================
   Full-moon detection
   ============================================================ */

// Find every full moon in a given Gregorian calendar year.
// Strategy: walk the year in 12-hour steps, detect phase crossings through 0.5,
// Returns array of true-phase full-moon Date objects sorted ascending,
// computed via SunPathMath.syzygyMomentAfter (Meeus Ch. 49).
function fullMoonsInYear(year) {
  var start = new Date(Date.UTC(year, 0, 1, 0, 0, 0));
  var end   = new Date(Date.UTC(year + 1, 0, 1, 0, 0, 0));
  var endMs = end.getTime();

  var moons = [];
  // Start the search 35 days before year-start so the first full moon
  // landing in early January is found (a syzygy on Dec 25 is irrelevant
  // but a Jan 2 full moon must not be missed).
  var cursor = new Date(start.getTime() - 35 * 86400000);

  while (true) {
    var next = SunPathMath.syzygyMomentAfter(cursor, 'full');
    if (!next) die('fullMoonsInYear(' + year + '): syzygyMomentAfter returned null');
    if (next.utcMs >= endMs) break;
    if (next.utcMs >= start.getTime()) {
      moons.push(new Date(next.utcMs));
    }
    cursor = new Date(next.utcMs + 86400000); // advance 1 day past, then re-search forward
  }

  return moons;
}

/* ============================================================
   bakeFullMoonsForYear
   ============================================================ */

function bakeFullMoonsForYear(year) {
  var moons = fullMoonsInYear(year);
  var count = moons.length;

  // AC #14: must be 12 or 13.
  if (count < 12 || count > 13) {
    die('bakeFullMoonsForYear(' + year + '): unexpected full-moon count ' + count + ' (expected 12 or 13)');
  }

  // DTSTAMP is the full-moon instant itself (deterministic — not bake time).
  // UID is deterministic: full-moon-<year>-<MM>-<DD>@pilgrimapp.org
  var vevents = moons.map(function (moon) {
    var yy  = moon.getUTCFullYear();
    var mm  = moon.getUTCMonth() + 1;
    var dd  = moon.getUTCDate();
    function pad(n) { return n < 10 ? '0' + n : '' + n; }
    var uid   = 'full-moon-' + yy + '-' + pad(mm) + '-' + pad(dd) + '@' + UID_DOMAIN;
    var dtstamp = fmtICS(moon);
    var dtstart = fmtICS(moon);
    // Use same 1-hour duration as sunpath turnings.
    var dtend = fmtICS(new Date(moon.getTime() + 3600000));

    return buildVEvent([
      'UID:'      + uid,
      'DTSTAMP:'  + dtstamp,
      'DTSTART:'  + dtstart,
      'DTEND:'    + dtend,
      'SUMMARY:Full Moon · ' + yy + '-' + pad(mm) + '-' + pad(dd),
      'DESCRIPTION:The full moon rises at its peak illumination.\\n\\nhttps://pilgrimapp.org/moonpath/',
      'CATEGORIES:Moon,Astronomy',
      'BEGIN:VALARM',
      'ACTION:DISPLAY',
      'DESCRIPTION:Full Moon tomorrow — peak moonlight tonight',
      'TRIGGER:-P1D',
      'END:VALARM'
    ]);
  });

  var calname  = 'Moon Path — Full Moons ' + year;
  var caldesc  = 'All full moons in ' + year + ' computed via Meeus Ch. 49 (±1 hr near J2000\\, drifting to ±0.5 day at the centuries). From pilgrimapp.org/moonpath/';
  return buildVCalendar(calname, caldesc, vevents);
}

/* ============================================================
   King-tide detection
   ============================================================ */

// Find king-tide moments in the next 30 days from bakeDate for a given port.
// A king tide occurs when a perigee and a syzygy (new or full moon) fall within
// ±3 days of each other.
// Returns array of { ms: number, syzygyKind: 'new'|'full', portName: string }.
function findKingTides(bakeDate, port) {
  var kingTides = [];
  var windowEnd = bakeDate.getTime() + KING_TIDE_WINDOW_MS;

  // Walk perigees through the 30-day window.
  var searchFrom = new Date(bakeDate.getTime());
  var MAX_PERIGEES = 2; // at most one per synodic month, so 2 in 30 days is enough
  for (var i = 0; i < MAX_PERIGEES; i++) {
    var perigee = SunPathMath.perigeeMomentAfter(searchFrom);
    if (!perigee || perigee.utcMs > windowEnd) break;

    // Search for nearest syzygy (new or full) within ±3 days.
    var kinds = ['new', 'full'];
    for (var k = 0; k < kinds.length; k++) {
      var kind = kinds[k];
      // Search from 3 days before perigee.
      var searchSyz = new Date(perigee.utcMs - SYZYGY_PERIGEE_TOLERANCE_MS);
      var syzygy = SunPathMath.syzygyMomentAfter(searchSyz, kind);
      if (syzygy && Math.abs(syzygy.utcMs - perigee.utcMs) <= SYZYGY_PERIGEE_TOLERANCE_MS) {
        // Use the perigee moment as the king-tide marker (tightest gravitational pull).
        kingTides.push({
          ms:         perigee.utcMs,
          syzygyKind: kind,
          portName:   port.name
        });
        break; // only one kind per perigee
      }
    }

    // Advance search past this perigee (anomalistic month ≈ 27.55 days).
    searchFrom = new Date(perigee.utcMs + 27 * 24 * 3600000);
  }

  return kingTides;
}

/* ============================================================
   bakeTideICSForPort
   ============================================================ */

function bakeTideICSForPort(port, bakeDate) {
  var kingTides = findKingTides(bakeDate, port);

  var vevents;

  if (kingTides.length === 0) {
    // D12: emit stub VEVENT when window is empty.
    // DTSTART = bake-date + 7 days (midnight UTC).
    var stubMs = bakeDate.getTime() + 7 * 24 * 3600000;
    var stubStart = new Date(Date.UTC(
      new Date(stubMs).getUTCFullYear(),
      new Date(stubMs).getUTCMonth(),
      new Date(stubMs).getUTCDate(),
      0, 0, 0
    ));
    var stubEnd = new Date(stubStart.getTime() + 3600000);
    // UID uses bake-date week for determinism.
    function pad2(n) { return n < 10 ? '0' + n : '' + n; }
    var bd = bakeDate;
    var stubUid = 'king-tide-stub-' + port.id + '-'
      + bd.getUTCFullYear() + '-' + pad2(bd.getUTCMonth() + 1) + '-' + pad2(bd.getUTCDate())
      + '@' + UID_DOMAIN;
    // DTSTAMP also deterministic: use stub DTSTART.
    vevents = [buildVEvent([
      'UID:'      + stubUid,
      'DTSTAMP:'  + fmtICS(stubStart),
      'DTSTART:'  + fmtICS(stubStart),
      'DTEND:'    + fmtICS(stubEnd),
      'SUMMARY:No king tides this month at ' + port.name,
      'DESCRIPTION:No perigee-syzygy alignment in the next 30 days at ' + port.name + '.\\n\\nhttps://pilgrimapp.org/moonpath/',
      'CATEGORIES:Tides,Astronomy',
      'BEGIN:VALARM',
      'ACTION:DISPLAY',
      'DESCRIPTION:No king tides this month at ' + port.name,
      'TRIGGER:-P1D',
      'END:VALARM'
    ])];
  } else {
    vevents = kingTides.map(function (kt) {
      var d = new Date(kt.ms);
      function pad2(n) { return n < 10 ? '0' + n : '' + n; }
      var uid = 'king-tide-' + port.id + '-'
        + d.getUTCFullYear() + '-' + pad2(d.getUTCMonth() + 1) + '-' + pad2(d.getUTCDate())
        + '@' + UID_DOMAIN;
      var dtstamp = fmtICS(d);
      var dtend   = fmtICS(new Date(d.getTime() + 3600000));
      var kindWord = kt.syzygyKind === 'full' ? 'full moon' : 'new moon';

      return buildVEvent([
        'UID:'      + uid,
        'DTSTAMP:'  + dtstamp,
        'DTSTART:'  + dtstamp,
        'DTEND:'    + dtend,
        'SUMMARY:King Tide at ' + port.name + ' (' + kindWord + ')',
        'DESCRIPTION:Perigee + ' + kindWord + ' alignment — highest predicted tides at ' + port.name + '.\\n\\nhttps://pilgrimapp.org/moonpath/',
        'CATEGORIES:Tides,King Tide,Astronomy',
        'BEGIN:VALARM',
        'ACTION:DISPLAY',
        'DESCRIPTION:King tide approaching at ' + port.name + ' — ' + kindWord + ' + perigee',
        'TRIGGER:-P1D',
        'END:VALARM'
      ]);
    });
  }

  var calname = 'Moon Path — King Tides · ' + port.name;
  var caldesc = 'King tides (perigee + syzygy alignment) in the next 30 days at ' + port.name + '. From pilgrimapp.org/moonpath/';
  return buildVCalendar(calname, caldesc, vevents);
}

/* ============================================================
   Entry point
   ============================================================ */

function main() {
  if (!fs.existsSync(PORTS_FILE)) {
    die('ports file not found: ' + PORTS_FILE);
  }

  var raw;
  try {
    raw = fs.readFileSync(PORTS_FILE, 'utf8');
  } catch (e) {
    die('could not read ' + PORTS_FILE + ': ' + e.message);
  }

  var data;
  try {
    data = JSON.parse(raw);
  } catch (e) {
    die('invalid JSON in ' + PORTS_FILE + ': ' + e.message);
  }

  if (!Array.isArray(data.ports) || data.ports.length === 0) {
    die('"ports" must be a non-empty array in ' + PORTS_FILE);
  }

  data.ports.forEach(function (port, i) {
    validatePort(port, i);
  });

  process.stdout.write('bake-moonpath-ics: ' + data.ports.length + ' port(s) validated OK\n');
  data.ports.forEach(function (p) {
    process.stdout.write('  ' + p.id + ' — ' + p.name + ' (' + p.country + ')\n');
  });

  // Ensure output directory exists.
  if (!fs.existsSync(OUT_DIR)) {
    fs.mkdirSync(OUT_DIR, { recursive: true });
  }

  // --- Bake full-moons ICS for current year and next year ---
  // Use a fixed bake anchor date for determinism: today's UTC date (at midnight).
  // We use 2026-05-14 as the fixed anchor (the plan date), but use actual Date
  // to make the script useful when re-run in future years. DTSTAMP on each
  // VEVENT is the event itself — not the bake date — so the file is stable
  // across re-bakes within the same year.
  var NOW = new Date();
  var currentYear = NOW.getUTCFullYear();

  [currentYear, currentYear + 1].forEach(function (year) {
    var ics  = bakeFullMoonsForYear(year);
    var outFile = path.join(OUT_DIR, 'full-moons-' + year + '.ics');
    fs.writeFileSync(outFile, ics);
    var count = (ics.match(/^BEGIN:VEVENT/gm) || []).length;
    process.stdout.write('wrote moonpath/full-moons-' + year + '.ics (' + count + ' events)\n');
  });

  // --- Bake tide-port king-tide ICS for each port ---
  // Bake anchor: use a fixed UTC date so the file is deterministic on same-day re-bakes.
  // The anchor is midnight UTC of the current date.
  var bakeDate = new Date(Date.UTC(NOW.getUTCFullYear(), NOW.getUTCMonth(), NOW.getUTCDate(), 0, 0, 0));

  data.ports.forEach(function (port) {
    var ics = bakeTideICSForPort(port, bakeDate);
    var outFile = path.join(OUT_DIR, 'tides-' + port.id + '.ics');
    fs.writeFileSync(outFile, ics);
    var count = (ics.match(/^BEGIN:VEVENT/gm) || []).length;
    process.stdout.write('wrote moonpath/tides-' + port.id + '.ics (' + count + ' events)\n');
  });
}

main();
