#!/usr/bin/env node
/* =============================================
   bake-moonpath-ics

   Reads assets/moonpath/tide-ports.json, validates schema for every
   port record, and exits 0 if all records are clean.

   In this slice (slice 2) the script only validates — no ICS output
   is produced yet. ICS generation is slice 7.

   Run from repo root:
     node scripts/bake-moonpath-ics
     ./scripts/bake-moonpath-ics

   Exit codes:
     0 — all port records pass validation
     1 — one or more records are invalid (single-line error to stderr)

   Required JSON shape (assets/moonpath/tide-ports.json):
     {
       "_epoch": "1900-01-01T00:00:00Z",
       "_speedSource": "...",
       "_constituents": [...],
       "_deferred": [...],
       "ports": [
         {
           "id":      string,
           "name":    string,
           "country": string,
           "lat":     number  (−90 … 90),
           "lon":     number  (−180 … 180),
           "source":  string,
           "license": string,
           "constituents": {
             "M2":  { "amp": number, "phase": number, "speed": number },
             ...  (10 entries, one per required constituent)
           }
         },
         ...
       ]
     }
   ============================================= */

'use strict';

var fs   = require('fs');
var path = require('path');

/* --- Constants --- */

var REPO_ROOT  = path.resolve(__dirname, '..');
var PORTS_FILE = path.join(REPO_ROOT, 'assets', 'moonpath', 'tide-ports.json');

var REQUIRED_CONSTITUENTS = ['M2', 'S2', 'N2', 'K1', 'O1', 'P1', 'Q1', 'K2', 'M4', 'MS4'];

var REQUIRED_PORT_FIELDS = ['id', 'name', 'country', 'lat', 'lon', 'source', 'license'];

/* --- Fail-loud helper --- */

function die(reason) {
  process.stderr.write('bake-moonpath-ics: ' + reason + '\n');
  process.exit(1);
}

/* --- Validation --- */

function validateConstituents(constituents, portId) {
  if (!constituents || typeof constituents !== 'object') {
    die('port "' + portId + '" — "constituents" must be an object');
  }
  REQUIRED_CONSTITUENTS.forEach(function (name) {
    var c = constituents[name];
    if (!c) {
      die('port "' + portId + '" — missing constituent "' + name + '"');
    }
    if (typeof c.amp !== 'number' || isNaN(c.amp)) {
      die('port "' + portId + '" — constituent "' + name + '".amp must be a number, got ' + JSON.stringify(c.amp));
    }
    if (typeof c.phase !== 'number' || isNaN(c.phase)) {
      die('port "' + portId + '" — constituent "' + name + '".phase must be a number, got ' + JSON.stringify(c.phase));
    }
    if (typeof c.speed !== 'number' || isNaN(c.speed)) {
      die('port "' + portId + '" — constituent "' + name + '".speed must be a number, got ' + JSON.stringify(c.speed));
    }
  });
}

function validatePort(port, index) {
  var label = 'port[' + index + ']' + (port.id ? ' ("' + port.id + '")' : '');

  REQUIRED_PORT_FIELDS.forEach(function (field) {
    if (port[field] === undefined || port[field] === null || port[field] === '') {
      die(label + ' — required field "' + field + '" is missing or empty');
    }
  });

  if (typeof port.lat !== 'number' || isNaN(port.lat) || port.lat < -90 || port.lat > 90) {
    die(label + ' — "lat" must be a number in [−90, 90], got ' + JSON.stringify(port.lat));
  }
  if (typeof port.lon !== 'number' || isNaN(port.lon) || port.lon < -180 || port.lon > 180) {
    die(label + ' — "lon" must be a number in [−180, 180], got ' + JSON.stringify(port.lon));
  }

  validateConstituents(port.constituents, port.id || String(index));
}

/* --- Entry point --- */

function main() {
  if (!fs.existsSync(PORTS_FILE)) {
    die('ports file not found: ' + PORTS_FILE);
  }

  var raw;
  try {
    raw = fs.readFileSync(PORTS_FILE, 'utf8');
  } catch (e) {
    die('could not read ' + PORTS_FILE + ': ' + e.message);
  }

  var data;
  try {
    data = JSON.parse(raw);
  } catch (e) {
    die('invalid JSON in ' + PORTS_FILE + ': ' + e.message);
  }

  if (!Array.isArray(data.ports) || data.ports.length === 0) {
    die('"ports" must be a non-empty array in ' + PORTS_FILE);
  }

  data.ports.forEach(function (port, i) {
    validatePort(port, i);
  });

  process.stdout.write('bake-moonpath-ics: ' + data.ports.length + ' port(s) validated OK\n');
  data.ports.forEach(function (p) {
    process.stdout.write('  ' + p.id + ' — ' + p.name + ' (' + p.country + ')\n');
  });
}

main();
