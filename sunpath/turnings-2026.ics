DTSTAMP:20260101T000000Z
DTSTART:20260621T082429Z
DTEND:20260621T092429Z
SUMMARY:Summer Solstice 2026 · 夏至
DESCRIPTION:The sun stands at its furthest north. The longest northern day.\n\nFrom here, northern days shorten until winter solstice.\n\nhttps://pilgrimapp.org/sunpath/2026-summer-solstice
URL:https://pilgrimapp.org/sunpath/2026-summer-solstice
CATEGORIES:Solstice,Astronomy
BEGIN:VALARM
ACTION:DISPLAY
DESCRIPTION:Summer Solstice tomorrow — the longest light
TRIGGER:-P1D
END:VALARM
END:VEVENT

